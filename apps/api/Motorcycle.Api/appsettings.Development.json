{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AdminAuth": {
    "FacebookRedirectUri": "https://localhost:7240/api/admin/auth/facebook/callback",
    "AdminAppUrl": "https://localhost:3001"
  },
  "UserAuth": {
    "WebAppUrl": "https://localhost:3000",
    "Facebook": {
      "RedirectUri": "https://localhost:7240/api/auth/facebook/callback"
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Swagger": {
    "Enabled": true
  },
  "RateLimiting": {
    "GeneralPerMinute": 3000,
    "AuthPerMinute": 100,
    "UploadPerMinute": 100
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:3000", "http://localhost:3001", "https://localhost:3001"]
  }
}
