@baseUrl = https://localhost:7240

### Record an opted-in bike view (replace with a published bike ID)
POST {{baseUrl}}/api/analytics/events
Content-Type: application/json

{ "type": "bike_view", "id": 1 }

### Record an opted-in zero-result search
POST {{baseUrl}}/api/analytics/events
Content-Type: application/json

{ "type": "search", "zeroResults": true }

### Reject a duplicate comparison
POST {{baseUrl}}/api/analytics/events
Content-Type: application/json

{ "type": "comparison", "bikeIds": [1, 1] }

### Admin dashboard (requires an active administrator session cookie)
GET {{baseUrl}}/api/admin/analytics

### Interest profile preference (requires the public user session cookie)
GET {{baseUrl}}/api/user/interests/preference

### Opt in (the request header triggers CORS preflight)
PUT {{baseUrl}}/api/user/interests/preference
Content-Type: application/json
X-Interest-Request: 1
Origin: https://localhost:3000

{ "enabled": true }

### Record a selected published bike
POST {{baseUrl}}/api/user/interests/events
Content-Type: application/json
X-Interest-Request: 1
Origin: https://localhost:3000

{ "type": "bike_search_selection", "id": 1 }

### Withdraw consent and delete the account's activity
PUT {{baseUrl}}/api/user/interests/preference
Content-Type: application/json
X-Interest-Request: 1
Origin: https://localhost:3000

{ "enabled": false }
